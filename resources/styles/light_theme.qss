/* Comprehensive Light Theme QSS stylesheet for OpenModelica Simulation Manager */

QMainWindow, QDialog, QMessageBox {
    background-color: #f6f8fa;
    color: #24292f;
}

QWidget {
    font-family: "Segoe UI", "SF Pro Display", -apple-system, BlinkMacSystemFont, Roboto, sans-serif;
    font-size: 13px;
    color: #24292f;
}

/* ToolBar */
QToolBar#MainToolBar {
    background-color: #ffffff;
    border-bottom: 1px solid #d0d7de;
    padding: 6px 10px;
    spacing: 8px;
}

QToolBar QLabel#ToolbarBrandLabel {
    color: #0969da;
    font-size: 14px;
}

/* Card Container */
QFrame#CardWidget {
    background-color: #ffffff;
    border: 1px solid #d0d7de;
    border-radius: 8px;
}

QLabel#CardTitle {
    color: #24292f;
    border-bottom: 1px solid #d0d7de;
    padding-bottom: 6px;
}

/* Command Preview Card */
QFrame#CommandPreviewCard {
    background-color: #f6f8fa;
    border: 1px solid #d0d7de;
    border-radius: 6px;
}

/* Text Inputs & Spinboxes */
QLineEdit, QSpinBox, QComboBox {
    background-color: #ffffff;
    border: 1px solid #d0d7de;
    border-radius: 6px;
    padding: 6px 10px;
    color: #24292f;
    selection-background-color: #0969da;
    selection-color: #ffffff;
}

QLineEdit:focus, QSpinBox:focus, QComboBox:focus {
    border: 1px solid #0969da;
}

QComboBox QAbstractItemView {
    background-color: #ffffff;
    border: 1px solid #d0d7de;
    selection-background-color: #0969da;
    selection-color: #ffffff;
    color: #24292f;
}

/* Buttons */
QPushButton {
    background-color: #f6f8fa;
    border: 1px solid #d0d7de;
    border-radius: 6px;
    padding: 6px 14px;
    color: #24292f;
    font-weight: 500;
}

QPushButton:hover {
    background-color: #f3f4f6;
    border-color: #8c959f;
}

QPushButton:disabled {
    background-color: #f6f8fa;
    border-color: #d0d7de;
    color: #8c959f;
}

/* Primary Run & Cancel Buttons */
QPushButton#RunButton {
    background-color: #1f883d;
    border: 1px solid #1a7f37;
    color: #ffffff;
    font-weight: bold;
    border-radius: 6px;
}

QPushButton#RunButton:hover {
    background-color: #1a7f37;
}

QPushButton#RunButton:disabled {
    background-color: #eaeef2;
    border-color: #d0d7de;
    color: #8c959f;
}

QPushButton#CancelButton {
    background-color: #cf222e;
    border: 1px solid #a40e26;
    color: #ffffff;
    font-weight: bold;
    border-radius: 6px;
}

QPushButton#CancelButton:hover {
    background-color: #a40e26;
}

/* Tab Widget & Tab Bar */
QTabWidget::pane {
    border: 1px solid #d0d7de;
    border-radius: 8px;
    background-color: #ffffff;
    top: -1px;
}

QTabBar::tab {
    background-color: #f6f8fa;
    border: 1px solid #d0d7de;
    border-bottom: none;
    border-top-left-radius: 6px;
    border-top-right-radius: 6px;
    padding: 8px 16px;
    margin-right: 4px;
    color: #57606a;
    font-weight: 600;
}

QTabBar::tab:selected {
    background-color: #ffffff;
    color: #0969da;
    border-bottom: 2px solid #0969da;
}

QTabBar::tab:hover:!selected {
    background-color: #ffffff;
    color: #24292f;
}

/* Table Widget (Execution History) */
QTableWidget {
    background-color: #ffffff;
    border: 1px solid #d0d7de;
    gridline-color: #e1e4e8;
    color: #24292f;
    border-radius: 6px;
}

QTableWidget::item {
    padding: 6px;
}

QTableWidget::item:selected {
    background-color: #0969da;
    color: #ffffff;
}

QHeaderView::section {
    background-color: #f6f8fa;
    color: #24292f;
    font-weight: bold;
    padding: 6px;
    border: 1px solid #d0d7de;
}

QTableCornerButton::section {
    background-color: #f6f8fa;
    border: 1px solid #d0d7de;
}

/* TextEdits (Console) */
QTextEdit#ConsoleOutput {
    background-color: #0d1117; /* Console remains dark for optimal terminal readability */
    border: 1px solid #d0d7de;
    border-radius: 6px;
    color: #c9d1d9;
    padding: 8px;
}

/* Checkboxes */
QCheckBox {
    color: #24292f;
    spacing: 6px;
}

QCheckBox::indicator {
    width: 16px;
    height: 16px;
    border: 1px solid #d0d7de;
    border-radius: 3px;
    background-color: #ffffff;
}

QCheckBox::indicator:checked {
    background-color: #0969da;
    border-color: #0969da;
}

/* Splitter */
QSplitter::handle {
    background-color: #d0d7de;
    height: 4px;
}

QSplitter::handle:hover {
    background-color: #0969da;
}

/* Status Bar */
QStatusBar {
    background-color: #ffffff;
    border-top: 1px solid #d0d7de;
    color: #57606a;
}
