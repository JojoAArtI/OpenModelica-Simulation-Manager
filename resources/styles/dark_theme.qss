/* Comprehensive Dark Theme QSS stylesheet for OpenModelica Simulation Manager */

QMainWindow, QDialog, QMessageBox {
    background-color: #0d1117;
    color: #c9d1d9;
}

QWidget {
    font-family: "Segoe UI", "SF Pro Display", -apple-system, BlinkMacSystemFont, Roboto, sans-serif;
    font-size: 13px;
    color: #c9d1d9;
}

/* ToolBar */
QToolBar#MainToolBar {
    background-color: #161b22;
    border-bottom: 1px solid #30363d;
    padding: 6px 10px;
    spacing: 8px;
}

QToolBar QLabel#ToolbarBrandLabel {
    color: #58a6ff;
    font-size: 14px;
}

/* Card Container */
QFrame#CardWidget {
    background-color: #161b22;
    border: 1px solid #30363d;
    border-radius: 8px;
}

QLabel#CardTitle {
    color: #f0f6fc;
    border-bottom: 1px solid #21262d;
    padding-bottom: 6px;
}

/* Command Preview Card */
QFrame#CommandPreviewCard {
    background-color: #0d1117;
    border: 1px solid #30363d;
    border-radius: 6px;
}

/* Text Inputs & Spinboxes */
QLineEdit, QSpinBox, QComboBox {
    background-color: #0d1117;
    border: 1px solid #30363d;
    border-radius: 6px;
    padding: 6px 10px;
    color: #c9d1d9;
    selection-background-color: #1f6feb;
    selection-color: #ffffff;
}

QLineEdit:focus, QSpinBox:focus, QComboBox:focus {
    border: 1px solid #58a6ff;
}

QSpinBox::up-button, QSpinBox::down-button {
    width: 18px;
    background-color: #21262d;
    border-radius: 3px;
}

QSpinBox::up-button:hover, QSpinBox::down-button:hover {
    background-color: #30363d;
}

QComboBox QAbstractItemView {
    background-color: #161b22;
    border: 1px solid #30363d;
    selection-background-color: #1f6feb;
    selection-color: #ffffff;
    color: #c9d1d9;
}

/* Buttons */
QPushButton {
    background-color: #21262d;
    border: 1px solid #30363d;
    border-radius: 6px;
    padding: 6px 14px;
    color: #c9d1d9;
    font-weight: 500;
}

QPushButton:hover {
    background-color: #30363d;
    border-color: #8b949e;
}

QPushButton:pressed {
    background-color: #161b22;
}

QPushButton:disabled {
    background-color: #161b22;
    border-color: #21262d;
    color: #484f58;
}

/* Primary Run & Cancel Buttons */
QPushButton#RunButton {
    background-color: #238636;
    border: 1px solid #2ea44f;
    color: #ffffff;
    font-weight: bold;
    border-radius: 6px;
}

QPushButton#RunButton:hover {
    background-color: #2ea44f;
    border-color: #3fb950;
}

QPushButton#RunButton:pressed {
    background-color: #1e7e34;
}

QPushButton#RunButton:disabled {
    background-color: #21262d;
    border-color: #30363d;
    color: #484f58;
}

QPushButton#CancelButton {
    background-color: #da3633;
    border: 1px solid #f85149;
    color: #ffffff;
    font-weight: bold;
    border-radius: 6px;
}

QPushButton#CancelButton:hover {
    background-color: #f85149;
}

/* Tab Widget & Tab Bar */
QTabWidget::pane {
    border: 1px solid #30363d;
    border-radius: 8px;
    background-color: #161b22;
    top: -1px;
}

QTabBar::tab {
    background-color: #0d1117;
    border: 1px solid #30363d;
    border-bottom: none;
    border-top-left-radius: 6px;
    border-top-right-radius: 6px;
    padding: 8px 16px;
    margin-right: 4px;
    color: #8b949e;
    font-weight: 600;
}

QTabBar::tab:selected {
    background-color: #161b22;
    color: #58a6ff;
    border-bottom: 2px solid #58a6ff;
}

QTabBar::tab:hover:!selected {
    background-color: #161b22;
    color: #c9d1d9;
}

/* Table Widget (Execution History) */
QTableWidget {
    background-color: #0d1117;
    border: 1px solid #30363d;
    gridline-color: #21262d;
    color: #c9d1d9;
    border-radius: 6px;
}

QTableWidget::item {
    padding: 6px;
}

QTableWidget::item:selected {
    background-color: #1f6feb;
    color: #ffffff;
}

QHeaderView::section {
    background-color: #161b22;
    color: #f0f6fc;
    font-weight: bold;
    padding: 6px;
    border: 1px solid #30363d;
}

QTableCornerButton::section {
    background-color: #161b22;
    border: 1px solid #30363d;
}

/* TextEdits (Console) */
QTextEdit#ConsoleOutput {
    background-color: #0d1117;
    border: 1px solid #30363d;
    border-radius: 6px;
    color: #c9d1d9;
    padding: 8px;
}

/* Checkboxes */
QCheckBox {
    color: #c9d1d9;
    spacing: 6px;
}

QCheckBox::indicator {
    width: 16px;
    height: 16px;
    border: 1px solid #30363d;
    border-radius: 3px;
    background-color: #0d1117;
}

QCheckBox::indicator:checked {
    background-color: #1f6feb;
    border-color: #58a6ff;
}

/* Splitter */
QSplitter::handle {
    background-color: #30363d;
    height: 4px;
}

QSplitter::handle:hover {
    background-color: #58a6ff;
}

/* Status Bar */
QStatusBar {
    background-color: #161b22;
    border-top: 1px solid #30363d;
    color: #8b949e;
}
